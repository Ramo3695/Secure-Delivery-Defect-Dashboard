          <mxGeometry height="24" width="500" x="40" y="785" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;" value="SR-01 authentication SR-02 password hashing SR-03 RBAC SR-04 input validation SR-05 audit logging SR-06 record authorization SR-07 login rate limits / lockout SR-08 session expiry SR-09 generic errors + secure diagnostics SR-10 security testing (development / verification activity)" vertex="1">
          <mxGeometry height="240" width="520" x="40" y="820" as="geometry" />
        </mxCell>
        <mxCell id="assets" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;" value="PROTECTED ASSETS • user accounts • password hashes • roles and permissions • route and defect records • audit logs" vertex="1">
          <mxGeometry height="160" width="340" x="590" y="820" as="geometry" />
        </mxCell>
        <mxCell id="attacks" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;" value="ATTACK SURFACES • login • dashboard forms • admin functions • API endpoints • database access • export features" vertex="1">
          <mxGeometry height="160" width="340" x="960" y="820" as="geometry" />
        </mxCell>
        <mxCell id="external" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;" value="EXTERNAL SYSTEMS None planned. The project uses fictional data only and does not connect to Amazon production systems." vertex="1">
          <mxGeometry height="120" width="420" x="1330" y="820" as="geometry" />
        </mxCell>
        <mxCell id="mapping_title" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#0F172A;fontSize=18;fontStyle=1;align=left;" value="THREAT TRACEABILITY" vertex="1">
          <mxGeometry height="24" width="300" x="40" y="1095" as="geometry" />
        </mxCell>
        <mxCell id="mapping" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;" value="T-01 spoofing → authentication, password hashing, and rate limiting reduce credential attacks. T-02 privilege escalation → server-side RBAC blocks elevated actions. T-03 malicious input → validation and parameterized SQL block unsafe input. T-04 record tampering → authorization + audit logging reduce unauthorized changes and improve detection. T-05 session hijacking → session expiry + secure cookies lower reuse risk. T-06 overload / abuse → API throttling reduces excessive-request volume. T-07 audit manipulation → protected logging limits undetected changes. T-08 error disclosure → generic error responses hide internals. T-09 storage exposure → restricted storage and deployment encryption reduce exposure. T-10 report disclosure → export authorization limits access." vertex="1">
          <mxGeometry height="170" width="2080" x="40" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="testing" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontColor=#065F46;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=16;" value="SR-10 • PRE-RELEASE SECURITY VERIFICATION: Test login, role authorization, invalid input handling, session expiry, rate limiting, logging, TLS, and export access; verify mitigations for T-01 through T-10." vertex="1">
          <mxGeometry height="50" width="2080" x="40" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="caption" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#475569;fontSize=14;align=left;" value="Figure 2. Level 1 secure architecture showing planned Flask components, trust zones, labeled data flows, security requirements SR-01–SR-10, and related threat IDs." vertex="1">
          <mxGeometry height="24" width="1400" x="40" y="1385" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
