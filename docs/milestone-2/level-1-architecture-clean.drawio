        <mxCell id="rule" parent="1" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;fontColor=#334155;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=14;" value="TRUST-BOUNDARY RULE: Requests crossing TB-1 → TB-2 should be authenticated as needed, authorized for the requested action, validated, and logged when appropriate. TB-2 → TB-3 access occurs only through backend services." vertex="1">
          <mxGeometry height="70" width="2080" x="40" y="690" as="geometry" />
        </mxCell>
